{
  "name": "mimir",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "biome check --write .",
    "test": "bun run tests/run-tests.ts",
    "test:server": "bun run tests/run-tests.ts server",
    "test:acp": "bun run tests/run-tests.ts acp",
    "server:dev": "bun run --filter @mimir/server dev",
    "server:start": "bun run --filter @mimir/server start",
    "acp:start": "bun run --filter @mimir/acp start",
    "acp:build": "bun run --filter @mimir/acp build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/bun": "latest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.133"
  }
}
