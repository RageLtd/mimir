{
  "name": "mimir",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "private": true,
  "scripts": {
    "check": "biome check --write .",
    "typecheck": "bun run tests/typecheck.ts",
    "test": "bun run --parallel --workspaces test && bun run test:root",
    "test:root": "bun test ./tests",
    "test:server": "bun run --cwd packages/server test",
    "test:cc-plugin": "bun run --cwd packages/cc-plugin test",
    "test:plugin-core": "bun run --cwd packages/plugin-core test",
    "test:oc-plugin": "bun run --cwd packages/oc-plugin test",
    "test:codex-plugin": "bun run --cwd packages/codex-plugin test",
    "server:dev": "bun run --filter @mimir/server dev",
    "start": "bun run --filter @mimir/server start",
    "cc-plugin:build": "bun run --filter @mimir/cc-plugin build",
    "cc-plugin:mod:validate": "bun run --cwd packages/cc-plugin mod:validate",
    "cc-plugin:mod:test": "bun run --cwd packages/cc-plugin mod:test",
    "codex-plugin:build": "bun run --filter @mimir/codex-plugin build",
    "skills:render": "bun packages/plugin-core/scripts/render-skills.ts"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalogs": {
      "ai-sdk": {
        "ai": "^6.0.158",
        "@ai-sdk/provider-utils": "^4.0.27"
      },
      "protocol": {
        "@anthropic-ai/claude-agent-sdk": "^0.3.154",
        "@modelcontextprotocol/sdk": "^1.29.0"
      },
      "server": {
        "hono": "^4.12.12",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "surrealdb": "^2.0.3",
        "zod": "^4.3.6"
      },
      "opencode": {
        "@opencode-ai/plugin": "^1.17.13"
      }
    }
  }
}
