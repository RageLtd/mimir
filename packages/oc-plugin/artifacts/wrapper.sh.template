#!/usr/bin/env bash
#
# mimir-opencode — launch OpenCode with the Mimir persona, plugin, and hooks.
# Sets MIMIR_ACTIVE so the plugin's in-process handlers distinguish a
# real Mimir session from a nested opencode subprocess that happens to
# inherit the same plugin file.

set -eo pipefail
export MIMIR_ACTIVE=1

# `mimir-opencode keys …` / `mimir-opencode sync` — E2E key ceremonies
# (MIM-87) and blind
# sync (MIM-88). The plugin bundle doubles as an argv program via its
# import.meta.main guard; OpenCode importing it as a plugin never
# triggers this path.
if [[ "${1:-}" == "keys" || "${1:-}" == "sync" ]]; then
  CMD="$1"
  shift
  exec bun "{{MIMIR_OC_RUNTIME}}" "$CMD" "$@"
fi

exec opencode "$@"
