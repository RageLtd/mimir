{
  "name": "@mimir/codex-plugin",
  "license": "SEE LICENSE IN LICENSE",
  "module": "src/cli.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "./build.sh",
    "build:darwin-arm64": "bun build src/cli.ts --compile --target=bun-darwin-arm64 --outfile=dist/darwin-arm64/mimir-codex-bin",
    "build:linux-x64": "bun build src/cli.ts --compile --target=bun-linux-x64 --outfile=dist/linux-x64/mimir-codex-bin",
    "test": "bun test --parallel src"
  },
  "dependencies": {
    "@ai-sdk/provider-utils": "catalog:ai-sdk",
    "@mimir/plugin-core": "workspace:*"
  }
}
