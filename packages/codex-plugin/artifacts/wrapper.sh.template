#!/usr/bin/env bash
#
# mimir-codex — launch vanilla Codex CLI with the Mimir persona, MCP
# servers, and lifecycle hooks installed by mimir-codex-plugin, all
# isolated in a dedicated CODEX_HOME so the user's own ~/.codex setup is
# untouched. MIMIR_ACTIVE lets hooks distinguish a real Mimir session
# from any other codex process that might load the same config.

set -eo pipefail
export MIMIR_ACTIVE=1
export CODEX_HOME="$HOME/.mimir/codex"

# Keep ~/.local/bin/mimir-codex-bin current before launching. ensure-binary.sh
# exits 0 when the binary is already up to date or when it's present but the
# release check can't reach GitHub, so a routine launch never blocks on the
# network; it only downloads when a newer codex-plugin release exists. A hard
# failure (no binary and no way to fetch one) is surfaced but not fatal —
# codex still launches.
ENSURE_BINARY="$HOME/.mimir/ensure-binary.sh"
if [[ -x "$ENSURE_BINARY" ]]; then
  "$ENSURE_BINARY" codex || echo "mimir-codex: binary update check failed — continuing with the installed binary." >&2
fi

# `mimir-codex keys …` / `sync` / `status` — ceremonies and health
# checks dispatched to mimir-codex-bin; never launches codex.
if [[ "${1:-}" == "keys" || "${1:-}" == "sync" || "${1:-}" == "status" ]]; then
  exec "$HOME/.local/bin/mimir-codex-bin" "$@"
fi

# Shared login: codex reads auth.json from CODEX_HOME (the managed
# config pins the file credential store). Link the vanilla ~/.codex
# credential in when it exists; refuse to create a dangling link — codex
# writes auth.json via atomic rename, which would replace the symlink and
# silently fork the two credential stores. No file there is normal on
# macOS, where vanilla codex defaults to the OS keyring: let codex prompt
# for login itself, and the credential lands in this home.
if [[ ! -e "$CODEX_HOME/auth.json" ]]; then
  if [[ -f "$HOME/.codex/auth.json" ]]; then
    ln -sf "$HOME/.codex/auth.json" "$CODEX_HOME/auth.json"
  else
    echo "mimir-codex: no ~/.codex/auth.json to share — sign in once here (\`mimir-codex login\`); the login is kept in $CODEX_HOME." >&2
  fi
fi

# The mimir MCP HTTP entry authenticates via bearer_token_env_var —
# export the gate key from the shared config when the env doesn't
# already carry one (env wins, same rotation discipline as the hooks).
if [[ -z "${MIMIR_API_KEY:-}" ]] && command -v jq >/dev/null 2>&1; then
  MIMIR_KEY_FROM_CONFIG=$(jq -r '.apiKey // empty' "$HOME/.mimir/config.json" 2>/dev/null || true)
  if [[ -n "$MIMIR_KEY_FROM_CONFIG" ]]; then
    export MIMIR_API_KEY="$MIMIR_KEY_FROM_CONFIG"
  fi
fi

exec codex "$@"
