# Mimir-managed Codex config block — regenerated by `mimir-codex-bin`
# install/update. Codex-written keys OUTSIDE the managed markers
# (project trust, personality, …) survive updates; hand-edits INSIDE
# the markers do not — and editing a hook line untrusts it silently
# (run `mimir-codex-bin update` to re-trust).

# Credentials live in auth.json inside THIS home. Codex defaults to the OS
# keyring on macOS, and keyring entries are keyed per CODEX_HOME, so an
# isolated home could never see the vanilla ~/.codex login. With the file
# store, the wrapper can link ~/.codex/auth.json in when it exists, and a
# `codex login` run through the wrapper lands here otherwise.
cli_auth_credentials_store = "file"

# ── MCP servers ─────────────────────────────────────────────────────────

[mcp_servers.mimir-local]
command = "{{MIMIR_CODEX_BIN}}"
args = ["user-memory-mcp"]
env = { MIMIR_USER_MEMORY_DB = "{{USER_MEMORY_DB}}", MIMIR_ORG_REPLICA_DB = "{{ORG_REPLICA_DB}}" }

[mcp_servers.mimir-logs]
command = "{{MIMIR_CODEX_BIN}}"
args = ["log-mcp"]

{{CARTOGRAPHER_BLOCK}}
# ── Lifecycle hooks ─────────────────────────────────────────────────────
# Trust entries ([hooks.state]) are appended below by the installer after
# querying `codex app-server` for each hook's identity hash — untrusted
# hooks are silently skipped by Codex.

# SessionStart runs a bounded 15s key-reconcile + org sync before
# detaching the reindex worker — the timeout must clear that ceiling.
[[hooks.SessionStart]]
hooks = [
  { type = "command", command = "{{MIMIR_CODEX_BIN}} session-start", timeout = 20 },
]

[[hooks.UserPromptSubmit]]
hooks = [
  { type = "command", command = "{{MIMIR_CODEX_BIN}} voice-anchor", timeout = 30 },
]

[[hooks.UserPromptSubmit]]
hooks = [
  { type = "command", command = "{{MIMIR_CODEX_BIN}} retrieve", timeout = 15 },
]

[[hooks.PreToolUse]]
hooks = [
  { type = "command", command = "{{MIMIR_CODEX_BIN}} rules", timeout = 5 },
]

[[hooks.PreToolUse]]
matcher = "^Bash$"
hooks = [
  { type = "command", command = "{{MIMIR_CODEX_BIN}} file-context", timeout = 5 },
]

[[hooks.PostToolUse]]
matcher = "^apply_patch$"
hooks = [
  { type = "command", command = "{{MIMIR_CODEX_BIN}} reindex", timeout = 5 },
]

# Stop runs extraction on the user's (often local, often slow) endpoint
# plus a bounded 10s sync push — give it room; a killed hook loses the
# distilled window's watermark advance.
[[hooks.Stop]]
hooks = [
  { type = "command", command = "{{MIMIR_CODEX_BIN}} persist", timeout = 45 },
]

[[hooks.PreCompact]]
hooks = [
  { type = "command", command = "{{MIMIR_CODEX_BIN}} precompact", timeout = 45 },
]
