{
  "description": "Mimir lifecycle hooks — fire in every session where the mimir-cc plugin is enabled. MIMIR_ACTIVE=1 is set inline so the binary's gates pass without the wrapper.",
  "modules": ["./register.ts"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MIMIR_ACTIVE=1 \"$HOME/.local/bin/mimir-cc\" session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MIMIR_ACTIVE=1 \"$HOME/.local/bin/mimir-cc\" persist",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "MIMIR_ACTIVE=1 \"$HOME/.local/bin/mimir-cc\" precompact",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "MIMIR_ACTIVE=1 \"$HOME/.local/bin/mimir-cc\" precompact",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
