{
  "mcpServers": {
    {{CARTOGRAPHER_BLOCK}}"mimir-local": {
      "command": "{{MIMIR_CC_BIN}}",
      "args": ["user-memory-mcp"],
      "env": {
        "MIMIR_USER_MEMORY_DB": "{{USER_MEMORY_DB}}",
        "MIMIR_ORG_REPLICA_DB": "{{ORG_REPLICA_DB}}"
      }
    },
    "mimir-logs": {
      "command": "{{MIMIR_CC_BIN}}",
      "args": ["log-mcp"]
    },
    "mimir": {
      "type": "http",
      "url": "{{MIMIR_SERVER_URL}}/mcp"{{MIMIR_AUTH_BLOCK}}
    }
  }
}
