{
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3",
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "worktree": {
    "baseRef": "head"
  },
  "extraKnownMarketplaces": {
    "rageltd": {
      "source": {
        "source": "github",
        "repo": "RageLtd/claude-plugins"
      },
      "autoUpdate": true
    }
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/credentials)",
      "Read(**/credentials.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)"
    ]
  }
}
