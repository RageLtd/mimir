#!/usr/bin/env bash
#
# mimir — launch vanilla Claude Code with the installed settings file. The
# persona, MCP servers and lifecycle hooks all come from the mimir-cc
# plugin (its hooks module composes the system prompt on every launch
# path), so a wrapper session differs from a plain `claude` in an enabled
# project by exactly one thing: --settings keeps ~/.claude/settings.json
# untouched. MIMIR_ACTIVE is exported for anything that still reads it;
# the plugin's hooks set it inline.
#
# The launch is an exec, so this process is gone by the time a session
# runs `mimir-cc update` and rewrites this file — bash reads scripts
# incrementally, and a wrapper that stayed resident across the rewrite
# would resume at a stale offset in the new file.

set -eo pipefail
export MIMIR_ACTIVE=1

# Keep ~/.local/bin/mimir-cc current before launching. ensure-binary.sh exits 0
# when the binary is already up to date or when it's present but the release
# check can't reach GitHub, so a routine launch never blocks on the network;
# it only downloads when a newer release exists. A hard failure (no binary and
# no way to fetch one) is surfaced but not fatal — claude still launches.
ENSURE_BINARY="$HOME/.mimir/ensure-binary.sh"
if [[ -x "$ENSURE_BINARY" ]]; then
  "$ENSURE_BINARY" || echo "mimir: binary update check failed — continuing with the installed binary." >&2
fi

# `mimir keys …` / `mimir sync` — E2E key ceremonies (MIM-87) and blind
# sync (MIM-88). Dispatched to the shared plugin-core implementation
# inside mimir-cc; never launches claude.
if [[ "${1:-}" == "keys" || "${1:-}" == "sync" ]]; then
  exec "$HOME/.local/bin/mimir-cc" "$@"
fi

exec claude --settings "$HOME/.mimir/settings.json" "$@"
