# Mimir server
MIMIR_PORT=8080
MIMIR_HOST=0.0.0.0

# vLLM on the Spark
VLLM_BASE_URL=
VLLM_MODEL=

# LM Studio — OpenAI-compatible local server (opt-in). Default port 1234.
# Set this to enable LM Studio model discovery. Models exposed are whatever
# is currently loaded in the LM Studio UI at startup; restart mimir-server
# after loading new models to pick them up.
# In LM Studio: enable "Serve on Local Network" if accessing from a different host.
LMSTUDIO_BASE_URL=

# SurrealDB (docker service name)
SURREAL_URL=http://surrealdb:8000/rpc
SURREAL_NS=mimir
SURREAL_DB=mimir
SURREAL_USER=
SURREAL_PASS=

SMALL_MODEL_BASE_URL=
SMALL_MODEL_PROVIDER_TYPE=ollama
SMALL_MODEL_MODEL=qwen3.5:9b

EMBED_MODEL=qwen3-embedding:0.6b
EMBED_TYPE=ollama
EMBED_BASE_URL=

# Context7 — docs lookup (free tier works without key, key raises limits)
# Get one at https://context7.com/dashboard
CONTEXT7_API_KEY=

# Tavily — web search (required for web_search tool)
# Get one at https://app.tavily.com
TAVILY_API_KEY=

# OpenCode Zen — multi-provider gateway for frontier model escalation
# Get your key at https://opencode.ai/auth
# Leave empty to disable Zen routing (all requests go to local vLLM)
# Enable OpenCode Zen Go subscription models via ZEN_GO_ENABLED
OPENCODE_API_KEY=
ZEN_GO_ENABLED=true
CHUTES_API_KEY=

# OpenRouter — multi-provider gateway (OpenAI-compatible)
# Get your key at https://openrouter.ai/keys
# Leave empty to disable OpenRouter routing
OPENROUTER_API_KEY=
OPENROUTER_ZDR=true
OPENROUTER_FREE=true
OPENROUTER_EXCLUDE=

# System prompt
SYSTEM_PROMPT_PATH=./system-prompt.md

# Memory hygiene — periodic background sweep that consolidates near-duplicate
# memories and forgets low-value ones. Runs in-process on a timer.
#
# REQUIRED to enable: a capable judgment model for fusing merged memories.
# No default — the sweep refuses to run (and logs a skip) when this is unset,
# rather than silently merging with the wrong model. Intended: GLM-5.1 via Zen.
HYGIENE_MODEL=
# SAFETY: dry-run computes and logs proposed merges/prunes but mutates NOTHING.
# Ships true. Flip to false only after validating proposals against your real
# store (POST /v1/hygiene/sweep returns the full proposal report on a dry run).
HYGIENE_DRY_RUN=true
# Scheduler on/off (the manual /v1/hygiene/sweep route works regardless).
HYGIENE_ENABLED=true
# Interval between automatic sweeps, in ms. Default 6 hours.
HYGIENE_INTERVAL_MS=21600000
# Model endpoint + key. Default to opencode-go / the shared Zen key when unset.
HYGIENE_MODEL_BASE_URL=
HYGIENE_MODEL_API_KEY=
# Consolidation: merge memories whose embedding distance is <= this. 0.18 was
# validated against a real 130-memory store (zero false positives). Tuning knobs
# below have sane defaults — override only with evidence from a dry-run report.
HYGIENE_MERGE_DISTANCE=0.18
# HYGIENE_MAX_CLUSTER_SIZE=5    # max memories folded into one canonical
# HYGIENE_MAX_MERGES=20         # hard cap on merges per sweep (blast-radius guard)
# HYGIENE_MAX_TOKENS=8192       # completion budget for a merge call
# Forgetting (prune low-value facts; never touches summary/playbook/skill):
# HYGIENE_SCORE_FLOOR=0.15      # prune facts scoring below this
# HYGIENE_MIN_AGE_DAYS=14       # never prune facts younger than this
# HYGIENE_CONFIDENCE_DECAY=0.9  # per-sweep decay for untouched facts
# HYGIENE_MAX_PRUNES=50         # hard cap on deletions per sweep
