# Mimir server
MIMIR_PORT=8080
MIMIR_HOST=0.0.0.0

# vLLM on the Spark
VLLM_BASE_URL=
VLLM_MODEL=

# LM Studio — OpenAI-compatible local server (opt-in). Default port 1234.
# Set this to enable LM Studio model discovery. Models exposed are whatever
# is currently loaded in the LM Studio UI at startup; restart mimir-server
# after loading new models to pick them up.
# In LM Studio: enable "Serve on Local Network" if accessing from a different host.
LMSTUDIO_BASE_URL=

# SurrealDB (docker service name)
SURREAL_URL=http://surrealdb:8000/rpc
SURREAL_NS=mimir
SURREAL_DB=mimir
SURREAL_USER=
SURREAL_PASS=

SMALL_MODEL_BASE_URL=
SMALL_MODEL_PROVIDER_TYPE=ollama
SMALL_MODEL_MODEL=qwen3.5:9b

EMBED_MODEL=qwen3-embedding:0.6b
EMBED_TYPE=ollama
EMBED_BASE_URL=

# Context7 — docs lookup (free tier works without key, key raises limits)
# Get one at https://context7.com/dashboard
CONTEXT7_API_KEY=

# Tavily — web search (required for web_search tool)
# Get one at https://app.tavily.com
TAVILY_API_KEY=

# OpenCode Zen — multi-provider gateway for frontier model escalation
# Get your key at https://opencode.ai/auth
# Leave empty to disable Zen routing (all requests go to local vLLM)
# Enable OpenCode Zen Go subscription models via ZEN_GO_ENABLED
OPENCODE_API_KEY=
ZEN_GO_ENABLED=true
CHUTES_API_KEY=

# OpenRouter — multi-provider gateway (OpenAI-compatible)
# Get your key at https://openrouter.ai/keys
# Leave empty to disable OpenRouter routing
OPENROUTER_API_KEY=
OPENROUTER_ZDR=true
OPENROUTER_FREE=true
OPENROUTER_EXCLUDE=

# System prompt
SYSTEM_PROMPT_PATH=./system-prompt.md
