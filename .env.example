# Mimir server
MIMIR_PORT=8080
MIMIR_HOST=0.0.0.0

# Tenant store (MIM-88) — one SQLite file: ciphertext envelopes, sync
# cursors, leases, project registry. Point at a persistent volume in
# deployments (Railway: /data/mimir.sqlite).
MIMIR_DB_PATH=./mimir.sqlite

# System prompt
SYSTEM_PROMPT_PATH=./system-prompt.md

# SurrealDB was REMOVED from the runtime (MIM-88) — the server stores
# ciphertext envelopes it cannot read; the memory brain lives client-side
# (MIM-84/85/86). SURREAL_* env is only read by the one-shot migration
# scripts (scripts/export-projects.ts, scripts/import-replica.ts) while
# an old instance is still reachable.
#
# Embeddings relocated client-side (MIM-85) — no EMBED_* knobs remain.
# Inference relocated client-side (MIM-89) — the server runs no models.
# Provider endpoints and keys (ANTHROPIC_API_KEY, OPENROUTER_API_KEY,
# OLLAMA_BASE_URL, …) are configured on the CLIENT (editor env / plugin
# config). web_search was REMOVED (MIM-90). Memory hygiene relocated
# client-side (MIM-86).
