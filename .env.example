# Mimir server
MIMIR_PORT=8080
MIMIR_HOST=0.0.0.0

# SurrealDB (docker service name)
SURREAL_URL=http://surrealdb:8000/rpc
SURREAL_NS=mimir
SURREAL_DB=mimir
SURREAL_USER=
SURREAL_PASS=

# Embedding endpoint — operator-pinned infrastructure for /mcp memory
# retrieval. type "openai" (default) is any OpenAI-compatible endpoint
# (self-hosted Ollama); type "cohere" is Cohere's native /v2/embed API.
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_TYPE=ollama
EMBED_BASE_URL=

# System prompt
SYSTEM_PROMPT_PATH=./system-prompt.md

# Inference relocated client-side (MIM-89) — the server runs no models.
# Provider endpoints and keys (ANTHROPIC_API_KEY, OPENROUTER_API_KEY,
# OLLAMA_BASE_URL, …) are configured on the CLIENT (editor env / plugin
# config); mimir-server keeps auth, the project registry, /mcp memory
# tools, and the system prompt. web_search was REMOVED (MIM-90) — search
# queries are content; docs lookup is the keyless client-side Context7 MCP.
#
# Memory hygiene relocated client-side (MIM-86) — the sweep runs locally
# over the replica via the plugin's `hygiene` command on the developer's
# extraction model (MIMIR_EXTRACTION_* trio). No server-side knobs remain.
